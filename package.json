{
  "name": "harnessed-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "contributors": [
    {
      "name": "Joe Gaudet",
      "url": "https://github.com/joegaudet"
    },
    {
      "name": "Jay Seo",
      "url": "https://github.com/jayseo5953"
    }
  ],
  "license": "MIT",
  "scripts": {
    "build": "pnpm run clean && tsc --build --force && pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc --build",
    "typecheck:packages": "tsc --build packages/core packages/config packages/dom packages/playwright packages/route packages/eslint-plugin packages/claude",
    "lint": "pnpm --filter @harnessed-ts/eslint-plugin build && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @harnessed-ts/eslint-plugin test && pnpm --filter conformance test",
    "test:dom": "pnpm --filter conformance test:dom",
    "test:playwright": "pnpm --filter conformance test:playwright",
    "release": "pnpm build && changeset publish --provenance",
    "test:rules": "pnpm --filter @harnessed-ts/eslint-plugin test",
    "clean": "pnpm -r --filter './packages/*' run clean && rm -rf tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@harnessed-ts/eslint-plugin": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
