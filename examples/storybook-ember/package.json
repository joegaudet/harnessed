{
  "name": "harnessed-example-storybook-ember",
  "private": true,
  "type": "module",
  "description": "A component harness driving an Ember form's Storybook play functions, and the same stories opened as fixtures from Playwright.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
