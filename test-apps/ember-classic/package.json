{
  "name": "test-app-ember-classic",
  "version": "0.0.0",
  "private": true,
  "description": "Runs the @harnessed-ts/conformance catalog under @harnessed-ts/ember: classic ember-cli build, ember-qunit.",
  "license": "MIT",
  "scripts": {
    "build": "ember build --environment=test",
    "test": "pnpm check:fixture && ember test",
    "start": "ember serve",
    "check:fixture": "diff -r ../ember-vite/app/components/fixture app/components/fixture",
    "test:exam": "ember exam --split=3 --parallel=1 --random"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@embroider/macros": "^1.21.1",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/template": "^1.9.0",
    "@harnessed-ts/conformance": "workspace:^",
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/ember": "workspace:^",
    "@harnessed-ts/page": "workspace:^",
    "@harnessed-ts/qunit": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/ember": "^3.0.12",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.9",
    "broccoli-asset-rev": "^3.0.0",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-exam": "^10.2.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.0",
    "ember-template-imports": "^4.4.0",
    "loader.js": "^4.7.0",
    "qunit": "^2.26.0",
    "typescript": "^5.9.3",
    "webpack": "^5.111.0"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  }
}
