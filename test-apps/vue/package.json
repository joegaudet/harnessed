{
  "name": "test-app-vue",
  "private": true,
  "description": "The Vue 3 port of the conformance fixture, held to the React original by a parity test and run under the dom and vitest-browser drivers; served for test-app-playwright-frameworks and mounted by test-app-cypress-ct-frameworks.",
  "type": "module",
  "exports": {
    "./fixture/*": "./src/fixture/*"
  },
  "scripts": {
    "test": "pnpm typecheck && pnpm test:dom",
    "test:dom": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "pnpm test && pnpm test:browser",
    "typecheck": "vue-tsc --noEmit -p .",
    "build": "vite build",
    "serve:fixture": "node scripts/serve-fixture.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@harnessed-ts/conformance": "workspace:^",
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/dom": "workspace:^",
    "@harnessed-ts/vitest-browser": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "5.0.3",
    "@vue/compiler-sfc": "^3.5.44",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue-tsc": "^3.3.13"
  }
}
