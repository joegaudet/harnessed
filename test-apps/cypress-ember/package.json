{
  "name": "test-app-cypress-ember",
  "private": true,
  "description": "Runs the conformance catalog under @harnessed-ts/cypress, as Cypress e2e specs against the Ember port of the fixture, served from test-app-ember-vite.",
  "type": "module",
  "scripts": {
    "serve": "FIXTURE_PORT=5191 pnpm --filter test-app-ember-vite serve:fixture",
    "cy:run": "cypress run --e2e --browser ${CYPRESS_BROWSER:-electron}",
    "test": "tsc --noEmit && start-server-and-test serve http-get://localhost:5191 cy:run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@harnessed-ts/chai": "workspace:*",
    "@harnessed-ts/conformance": "workspace:*",
    "@harnessed-ts/core": "workspace:*",
    "@harnessed-ts/cypress": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "cypress": "^16.1.1",
    "start-server-and-test": "^3.0.12",
    "test-app-cypress-e2e": "workspace:*",
    "test-app-ember-vite": "workspace:*",
    "typescript": "^6.0.3"
  }
}
