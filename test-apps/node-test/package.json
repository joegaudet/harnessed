{
  "name": "test-app-node-test",
  "private": true,
  "description": "Runs the @harnessed-ts/conformance catalog under @harnessed-ts/dom, with node:test as the runner and jsdom as the DOM.",
  "type": "module",
  "scripts": {
    "test": "pnpm typecheck && node --test --import global-jsdom/register --import @harnessed-ts/core/register \"tests/**/*.test.tsx\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@harnessed-ts/chai": "workspace:*",
    "@harnessed-ts/conformance": "workspace:*",
    "@harnessed-ts/core": "workspace:*",
    "@harnessed-ts/dom": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
