{
  "name": "test-app-svelte",
  "private": true,
  "description": "The Svelte 5 port of the conformance fixture, held to the React original by a parity test and run under the dom and vitest-browser drivers; served for test-app-playwright-frameworks and mounted by test-app-cypress-ct-frameworks.",
  "type": "module",
  "exports": {
    "./fixture/*": "./src/fixture/*"
  },
  "scripts": {
    "test": "pnpm typecheck && pnpm test:dom",
    "test:dom": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "pnpm test && pnpm test:browser",
    "typecheck": "svelte-check --fail-on-warnings --tsconfig ./tsconfig.json",
    "build": "vite build",
    "serve:fixture": "node scripts/serve-fixture.mjs"
  },
  "dependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@harnessed-ts/conformance": "workspace:^",
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/dom": "workspace:^",
    "@harnessed-ts/vitest-browser": "workspace:^",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@vitest/browser-playwright": "5.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.64.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  }
}
