{
  "name": "test-app-angular",
  "private": true,
  "description": "Runs the @harnessed-ts/conformance catalog against an Angular port of the fixture: zoneless, standalone, built by Vite through @analogjs/vite-plugin-angular.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "vite",
    "serve:fixture": "node scripts/serve-fixture.mjs",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.harness.json && ngc -p tsconfig.cypress.json --noEmit && tsc -p tsconfig.tools.json",
    "test": "pnpm typecheck && pnpm test:dom && pnpm test:browser",
    "test:dom": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:cypress": "cypress run --component --browser ${CYPRESS_BROWSER:-electron}"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/build": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@cypress/vite-dev-server": "^8.0.0",
    "@harnessed-ts/angular": "workspace:^",
    "@harnessed-ts/conformance": "workspace:^",
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/cypress": "workspace:^",
    "@harnessed-ts/page": "workspace:^",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@vitest/browser-playwright": "5.0.3",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
