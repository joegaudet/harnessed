{
  "name": "test-app-ember-vite",
  "version": "0.0.0",
  "private": true,
  "description": "Runs the @harnessed-ts/conformance catalog under @harnessed-ts/ember: Embroider + Vite, ember-qunit.",
  "license": "MIT",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "node scripts/with-build-lock.mjs vite build --mode development",
    "test": "pnpm typecheck && node --test \"scripts/*.test.mjs\" && pnpm build && testem ci --port 0",
    "start": "vite",
    "serve:fixture": "node scripts/serve-fixture.mjs",
    "typecheck": "ember-tsc --build",
    "test:vitest": "node scripts/with-build-lock.mjs vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.13",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.11.4",
    "@glint/template": "^1.9.0",
    "@harnessed-ts/chai": "workspace:^",
    "@harnessed-ts/conformance": "workspace:^",
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/ember": "workspace:^",
    "@harnessed-ts/page": "workspace:^",
    "@harnessed-ts/qunit": "workspace:^",
    "@rollup/plugin-babel": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.9",
    "@vitest/browser-playwright": "5.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.0",
    "ember-vitest": "^0.9.0",
    "playwright": "^1.62.1",
    "qunit": "^2.26.0",
    "testem": "^3.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  }
}
