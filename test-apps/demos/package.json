{
  "name": "test-app-demos",
  "private": true,
  "description": "One demo flow, written once against the conformance harnesses, run and recorded under RTL, Playwright and Cypress against the React fixture and its Ember copy.",
  "type": "module",
  "scripts": {
    "serve:react": "FIXTURE_PORT=5271 pnpm --filter conformance serve:fixture",
    "serve:ember": "FIXTURE_PORT=5272 pnpm --filter test-app-ember-vite serve:fixture",
    "typecheck": "tsc -p .",
    "test": "pnpm typecheck && pnpm test:rtl && pnpm test:playwright && pnpm test:cypress",
    "test:rtl": "vitest run",
    "test:playwright": "playwright test",
    "test:cypress": "start-server-and-test serve:react http-get://localhost:5271 serve:ember http-get://localhost:5272 cy:both",
    "cy:both": "pnpm cy:react && pnpm cy:ember",
    "cy:react": "cypress run --e2e --browser ${CYPRESS_BROWSER:-electron} --config baseUrl=http://localhost:5271 --expose DEMO_APP=react",
    "cy:ember": "cypress run --e2e --browser ${CYPRESS_BROWSER:-electron} --config baseUrl=http://localhost:5272 --expose DEMO_APP=ember",
    "record": "node scripts/record.mjs",
    "record:rtl": "node scripts/record.mjs rtl",
    "record:playwright-react": "node scripts/record.mjs playwright-react",
    "record:playwright-ember": "node scripts/record.mjs playwright-ember",
    "record:cypress-react": "node scripts/record.mjs cypress-react",
    "record:cypress-ember": "node scripts/record.mjs cypress-ember"
  },
  "devDependencies": {
    "@harnessed-ts/conformance": "workspace:*",
    "@harnessed-ts/core": "workspace:*",
    "@harnessed-ts/cypress": "workspace:*",
    "@harnessed-ts/dom": "workspace:*",
    "@harnessed-ts/playwright": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "cypress": "^16.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "start-server-and-test": "^3.0.12",
    "test-app-cypress-e2e": "workspace:*",
    "test-app-ember-vite": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
