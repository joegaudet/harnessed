{
  "name": "test-app-webdriverio",
  "private": true,
  "description": "Runs the @harnessed-ts/conformance catalog under @harnessed-ts/webdriverio, with the WDIO testrunner, Mocha and headless Chrome.",
  "type": "module",
  "scripts": {
    "test": "pnpm typecheck && pnpm test:bidi && pnpm test:classic",
    "test:bidi": "wdio run ./wdio.conf.ts",
    "test:classic": "wdio run ./wdio.classic.conf.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@harnessed-ts/conformance": "workspace:^",
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/webdriverio": "workspace:^",
    "@types/node": "^26.4.1",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "@wdio/types": "^10.0.0",
    "expect-webdriverio": "^8.0.0-alpha.3",
    "webdriverio": "^10.0.0"
  }
}
