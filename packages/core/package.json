{
  "name": "@harnessed-ts/core",
  "version": "0.4.0",
  "description": "Component harnesses that run under any test driver — the driver-free core.",
  "keywords": [
    "testing",
    "harness",
    "page-object",
    "component-harness",
    "test-fixture"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "Joe Gaudet",
      "url": "https://github.com/joegaudet"
    },
    {
      "name": "Jay Seo",
      "url": "https://github.com/jayseo5953"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/harnessed.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/joegaudet/harnessed#readme",
  "bugs": "https://github.com/joegaudet/harnessed/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tsconfig.json": "./tsconfig.harnessed.json",
    "./package.json": "./package.json",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "import": "./dist/babel.js",
      "require": "./dist/babel.cjs"
    }
  },
  "files": [
    "dist",
    "tsconfig.harnessed.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@babel/core": ">=7.24.0 <8",
    "@babel/plugin-proposal-decorators": ">=7.24.0 <8",
    "@babel/plugin-syntax-jsx": ">=7.24.0 <8",
    "@babel/plugin-transform-class-static-block": ">=7.24.0 <8",
    "@babel/plugin-transform-typescript": ">=7.24.0 <8",
    "esbuild": ">=0.21",
    "typescript": ">=5.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "@babel/core": {
      "optional": true
    },
    "@babel/plugin-proposal-decorators": {
      "optional": true
    },
    "@babel/plugin-transform-class-static-block": {
      "optional": true
    },
    "@babel/plugin-transform-typescript": {
      "optional": true
    },
    "@babel/plugin-syntax-jsx": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.3",
    "decorator-transforms": "^2.4.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  }
}
