{
  "name": "conformance",
  "version": "0.1.0",
  "private": true,
  "description": "One suite of behavioural specs, run under every driver. Divergence is a failing test.",
  "type": "module",
  "scripts": {
    "test": "pnpm test:dom && pnpm test:playwright",
    "test:dom": "vitest run --config runners/vitest.config.ts",
    "test:playwright": "playwright test --config runners/playwright.config.ts",
    "dev": "vite --config runners/vite.config.ts",
    "build": "echo 'conformance is not published' && exit 0",
    "clean": "rm -rf dist *.tsbuildinfo test-results playwright-report"
  },
  "dependencies": {
    "@harnessed/core": "workspace:^",
    "@harnessed/dom": "workspace:^",
    "@harnessed/playwright": "workspace:^",
    "@harnessed/route": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
