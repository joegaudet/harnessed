{
  "name": "@harnessed-ts/storybook",
  "version": "0.7.0",
  "description": "Harnesses in Storybook: drive play() functions through a harness, and open stories as fixtures from any runner that can navigate. React and Ember.",
  "keywords": [
    "testing",
    "harness",
    "storybook",
    "play-function",
    "interactions",
    "ember"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "Joe Gaudet",
      "url": "https://github.com/joegaudet"
    },
    {
      "name": "Jay Seo",
      "url": "https://github.com/jayseo5953"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/harnessed.git",
    "directory": "packages/storybook"
  },
  "homepage": "https://github.com/joegaudet/harnessed#readme",
  "bugs": "https://github.com/joegaudet/harnessed/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js",
      "require": "./dist/page.cjs"
    },
    "./ember": {
      "types": "./dist/ember.d.ts",
      "import": "./dist/ember.js",
      "require": "./dist/ember.cjs"
    },
    "./ember/node": {
      "types": "./dist/ember-node.d.ts",
      "import": "./dist/ember-node.js",
      "require": "./dist/ember-node.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/dom": "workspace:^",
    "@harnessed-ts/page": "workspace:^"
  },
  "peerDependencies": {
    "@ember/test-waiters": ">=4",
    "@testing-library/dom": ">=10",
    "@testing-library/user-event": ">=14",
    "content-tag": ">=3",
    "ember-source": ">=6.8",
    "storybook": ">=9"
  },
  "peerDependenciesMeta": {
    "@ember/test-waiters": {
      "optional": true
    },
    "content-tag": {
      "optional": true
    },
    "ember-source": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ember/test-waiters": "^4.1.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "content-tag": "^4.2.1",
    "ember-source": "~7.3.0",
    "jsdom": "^30.1.2",
    "storybook": "10.6.1",
    "vitest": "^5.0.3"
  }
}
