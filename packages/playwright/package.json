{
  "name": "@harnessed-ts/playwright",
  "version": "0.2.0",
  "description": "Playwright driver for @harnessed-ts/core, plus API stubbing and BDD world helpers.",
  "keywords": [
    "testing",
    "harness",
    "playwright",
    "page-object",
    "e2e"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "Joe Gaudet",
      "url": "https://github.com/joegaudet"
    },
    {
      "name": "Jay Seo",
      "url": "https://github.com/jayseo5953"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/harnessed.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/joegaudet/harnessed#readme",
  "bugs": "https://github.com/joegaudet/harnessed/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "import": "./dist/matchers.js",
      "require": "./dist/matchers.cjs"
    },
    "./bdd": {
      "types": "./dist/bdd.d.ts",
      "import": "./dist/bdd.js",
      "require": "./dist/bdd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@harnessed-ts/core": "workspace:^"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
