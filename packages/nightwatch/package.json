{
  "name": "@harnessed-ts/nightwatch",
  "version": "0.8.0",
  "description": "Nightwatch driver for @harnessed-ts/core: the shared resolver injected into the page, selenium-webdriver actions, and frames entered from outside the page.",
  "keywords": [
    "testing",
    "harness",
    "nightwatch",
    "selenium",
    "webdriver",
    "page-object",
    "e2e"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "Joe Gaudet",
      "url": "https://github.com/joegaudet"
    },
    {
      "name": "Jay Seo",
      "url": "https://github.com/jayseo5953"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/harnessed.git",
    "directory": "packages/nightwatch"
  },
  "homepage": "https://github.com/joegaudet/harnessed#readme",
  "bugs": "https://github.com/joegaudet/harnessed/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/resolve": "workspace:^"
  },
  "peerDependencies": {
    "nightwatch": ">=3"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "nightwatch": "^3.16.0",
    "vitest": "^5.0.3"
  }
}
