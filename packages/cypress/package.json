{
  "name": "@harnessed-ts/cypress",
  "version": "0.3.0",
  "description": "Cypress driver for @harnessed-ts/core: a cy.harness() bridge that runs harnesses against the app under test, in e2e and component tests.",
  "keywords": [
    "testing",
    "harness",
    "cypress",
    "page-object",
    "e2e",
    "component-testing"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "Joe Gaudet",
      "url": "https://github.com/joegaudet"
    },
    {
      "name": "Jay Seo",
      "url": "https://github.com/jayseo5953"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/harnessed.git",
    "directory": "packages/cypress"
  },
  "homepage": "https://github.com/joegaudet/harnessed#readme",
  "bugs": "https://github.com/joegaudet/harnessed/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "import": "./dist/support.js",
      "require": "./dist/support.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@harnessed-ts/core": "workspace:^",
    "@harnessed-ts/resolve": "workspace:^"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=10",
    "@testing-library/user-event": ">=14",
    "cypress": ">=13"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "cypress": "^16.1.1"
  }
}
