    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.1",
    "@embroider/core": "^4.6.7",
