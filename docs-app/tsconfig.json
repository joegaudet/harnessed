{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types"],
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "docs-app/tests/*": ["./tests/*"],
      "docs-app/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types"
    ],
    "jsx": "react-jsx"
  },
  "exclude": ["tests/harness", "tests/react"],
  "references": [
    {
      "path": "./tests/harness"
    },
    {
      "path": "./tests/react"
    }
  ]
}
